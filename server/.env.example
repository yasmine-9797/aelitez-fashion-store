# AELITEZ API — environment template. Copy to `.env` and fill in real values.
# Never commit `.env`. All values below are placeholders.

# ---------- Server ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of trusted reverse-proxy hops in front of the API (0 locally, usually 1 in production).
TRUST_PROXY=0
# Public URL of this API — used to build URLs for uploaded images.
PUBLIC_API_URL=http://localhost:4000
# Public URL of the storefront — used in emails (password reset, verification).
STOREFRONT_URL=http://localhost:8080
# Comma-separated list of browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:8080

# ---------- Database (PostgreSQL) ----------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aelitez?schema=public"
# Separate database used by `npm test` — it is wiped between test runs.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aelitez_test?schema=public"

# ---------- Cookies ----------
# Secure cookies are always on when NODE_ENV=production.
# Use SameSite=none only if the storefront and API are on different sites (requires HTTPS).
COOKIE_SAMESITE=lax
# Optional, e.g. `.aelitez.com` so `www.` and `api.` share the session cookie.
COOKIE_DOMAIN=

# ---------- Payments ----------
# Razorpay: payments stay disabled until all three values are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Cash on delivery is a business decision — disabled unless explicitly enabled.
COD_ENABLED=false
# Unpaid online orders release their reserved stock after this many minutes.
PAYMENT_TIMEOUT_MINUTES=30

# ---------- Email (SMTP) ----------
# Leave SMTP_HOST empty to disable sending. In development, emails are then written to ./.outbox instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="AELITEZ CLOTHINGS <no-reply@example.com>"

# ---------- Uploads ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ---------- Business rules ----------
RETURN_WINDOW_DAYS=7
MAX_CART_QUANTITY=10

# ---------- Admin bootstrap (only read by `npm run create-admin`) ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
