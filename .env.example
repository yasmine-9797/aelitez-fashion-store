# Storefront environment template — copy to `.env` (never commit `.env`).
# Public values only: everything prefixed VITE_ is bundled into the browser code.

# URL of the AELITEZ API (the `server/` app). Required in production.
VITE_API_URL=http://localhost:4000
# Public URL of this storefront — used for canonical URLs, Open Graph and the sitemap.
VITE_SITE_URL=http://localhost:8080
